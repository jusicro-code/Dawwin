# Copy to .env.local for local development. Never commit real values.
# --- Public (safe in the browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SITE_URL=https://your-domain.example
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
# --- Server-only secrets ---
# Random 64-char hex; its SHA-256 must be stored in private.config (key: server_secret_sha256)
INTERNAL_RPC_SECRET=
CRON_SECRET=
# Moyasar (mada / Apple Pay / Visa / Mastercard) — use test keys until go-live
MOYASAR_SECRET_KEY=
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_WEBHOOK_SECRET=
# Tabby — keep empty until merchant + livestock category approval
TABBY_SECRET_KEY=
TABBY_PUBLIC_KEY=
TABBY_MERCHANT_CODE=
TABBY_WEBHOOK_SECRET=
TABBY_WEBHOOK_HEADER=x-webhook-secret
# Tamara — keep empty until merchant + livestock category approval
TAMARA_API_TOKEN=
TAMARA_NOTIFICATION_TOKEN=
TAMARA_API_BASE_URL=https://api-sandbox.tamara.co
# WhatsApp Cloud API (approved template required)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_ORDER_UPDATE=
WHATSAPP_TEMPLATE_LANG=ar
